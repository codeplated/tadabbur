{
  "title": "data/personalities.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "name": {
        "type": "object",
        "properties": {
          "en": {
            "type": "string",
            "minLength": 1
          },
          "ar": {
            "type": "string",
            "minLength": 1
          },
          "ur": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["en", "ar", "ur"]
      },
      "aliases": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "kind": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "order": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "path": {
        "type": "string",
        "enum": ["straight", "deviated", "mixed"]
      },
      "pathOrder": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "pathLabel": {
        "type": "object",
        "properties": {
          "en": {
            "type": "string",
            "minLength": 1
          },
          "ur": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["en", "ur"]
      },
      "pathReason": {
        "type": "string",
        "minLength": 1
      },
      "era": {
        "type": "string",
        "minLength": 1
      },
      "story": {
        "type": "object",
        "properties": {
          "en": {
            "type": "string",
            "minLength": 1
          },
          "ur": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["en", "ur"]
      },
      "lessons": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "ayaat": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^\\d{1,3}:\\d{1,3}$"
        }
      },
      "connected": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "themes": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "notes": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "id",
      "name",
      "aliases",
      "kind",
      "order",
      "path",
      "pathOrder",
      "pathLabel",
      "pathReason",
      "era",
      "story",
      "lessons",
      "ayaat",
      "connected",
      "themes"
    ]
  }
}
