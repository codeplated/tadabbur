{
  "title": "data/canvases/<slug>.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "surah": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              },
              "color": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "const": "ayah"
              },
              "ayah": {
                "type": "string",
                "pattern": "^\\d{1,3}:\\d{1,3}$"
              }
            },
            "required": ["id", "x", "y", "width", "height", "type", "ayah"]
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              },
              "color": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "const": "path"
              },
              "path": {
                "type": "string",
                "enum": ["straight", "deviated", "mixed"]
              }
            },
            "required": ["id", "x", "y", "width", "height", "type", "path"]
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              },
              "color": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "const": "image"
              },
              "image": {
                "type": "string",
                "pattern": "^surah_\\d{3}\\.png$"
              }
            },
            "required": ["id", "x", "y", "width", "height", "type", "image"]
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              },
              "color": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "const": "text"
              },
              "text": {
                "type": "string"
              }
            },
            "required": ["id", "x", "y", "width", "height", "type", "text"]
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              },
              "color": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "const": "group"
              },
              "label": {
                "type": "string"
              }
            },
            "required": ["id", "x", "y", "width", "height", "type"]
          }
        ]
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "fromNode": {
            "type": "string",
            "minLength": 1
          },
          "toNode": {
            "type": "string",
            "minLength": 1
          },
          "fromSide": {
            "type": "string",
            "enum": ["top", "right", "bottom", "left"]
          },
          "toSide": {
            "type": "string",
            "enum": ["top", "right", "bottom", "left"]
          },
          "toEnd": {
            "type": "string",
            "enum": ["none", "arrow"]
          },
          "label": {
            "type": "string"
          },
          "color": {
            "type": "string"
          }
        },
        "required": ["id", "fromNode", "toNode"]
      }
    }
  },
  "required": ["id", "title", "nodes", "edges"]
}
