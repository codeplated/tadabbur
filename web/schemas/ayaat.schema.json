{
  "title": "data/ayaat/NNN.json (one surah's ayaat, in order)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^\\d{1,3}:\\d{1,3}$"
      },
      "surah": {
        "type": "string"
      },
      "number": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "globalNumber": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 6236
      },
      "bismillah": {
        "type": "boolean"
      },
      "arabic": {
        "type": "string",
        "minLength": 1
      },
      "urdu": {
        "type": "string",
        "minLength": 1
      },
      "english": {
        "type": "string",
        "minLength": 1
      },
      "tafsir": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "paragraphs": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": ["source", "paragraphs"]
      },
      "themes": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "related": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^\\d{1,3}:\\d{1,3}$"
        }
      },
      "notes": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "id",
      "surah",
      "number",
      "globalNumber",
      "bismillah",
      "arabic",
      "urdu",
      "english",
      "tafsir",
      "themes",
      "related"
    ]
  }
}
