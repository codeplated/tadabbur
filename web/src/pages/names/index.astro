---
import Base from "../../layouts/Base.astro"
import { href } from "../../lib/format"
import { site } from "../../lib/site"

const s = await site()
const groups = s.nameCategories.map((category) => ({ category, names: s.namesIn(category.id) }))
---

<Base
  title="Names of Allah"
  description="Asma ul Husna: the 99 Names of Allah, grouped by what they tell us, each with its root, meaning and the ayaat it appears in."
>
  <div class="wrap">
    <header class="page-head">
      <h1>Names of Allah</h1>
      <p class="ar" lang="ar" dir="rtl">
        ٱلْأَسْمَاءُ ٱلْحُسْنَىٰ
      </p>
      <p class="facts">
        The 99 Names, grouped by what they tell us. Each opens to its root, meaning and the ayaat it
        appears in.
      </p>
    </header>

    {groups.map(({ category, names }) => (
      <section class="section" aria-labelledby={category.id}>
        <h2 id={category.id}>
          {category.label} <span class="muted">{names.length}</span>
        </h2>
        <ol class="names plain-list">
          {names.map((n) => (
            <li>
              <a href={href.name(n.id)}>
                <span class="number">{n.number}</span>
                <span class="arabic" lang="ar" dir="rtl">
                  {n.arabic}
                </span>
                <span class="transliteration">{n.transliteration}</span>
                <span class="meaning">{n.english}</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</Base>

<style>
  .ar {
    font-size: var(--step-3);
    color: var(--muted);
    line-height: 1.6;
  }

  h2 .muted {
    font-weight: 400;
    font-size: var(--step-0);
  }

  .names {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  @media (min-width: 48rem) {
    .names {
      grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    }
  }

  .names a {
    position: relative;
    display: grid;
    gap: 0.1rem;
    height: 100%;
    padding: 0.75rem 0.9rem 0.9rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    color: var(--ink);
    text-decoration: none;
  }

  .names a:hover {
    border-color: var(--teal);
  }

  .names a:hover .transliteration {
    color: var(--teal);
  }

  .number {
    position: absolute;
    inset-block-start: 0.6rem;
    inset-inline-start: 0.75rem;
    font-size: var(--step--1);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .arabic {
    font-size: 2rem;
    line-height: 1.8;
    text-align: center;
    color: var(--teal-strong);
  }

  .transliteration {
    font-weight: 600;
    text-align: center;
  }

  .meaning {
    font-size: var(--step--1);
    color: var(--muted);
    text-align: center;
    line-height: 1.4;
  }
</style>
