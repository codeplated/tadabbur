---
import { Image } from "astro:assets"
import { href, plural, revelationLabel } from "../lib/format"
import { surahImage } from "../lib/images"
import type { Surah } from "../lib/site"

interface Props {
  surah: Surah
  /** The first cards on a page load eagerly. */
  eager?: boolean
}

const { surah, eager = false } = Astro.props
---

<a class="surah-card" href={href.surah(surah)}>
  <Image
    src={surahImage(surah.image)}
    alt=""
    widths={[320, 480, 640]}
    sizes="(min-width: 72rem) 22rem, (min-width: 48rem) 33vw, 50vw"
    loading={eager ? "eager" : "lazy"}
    format="webp"
    quality={70}
  />
  <span class="body">
    <span class="title">
      <span class="number">{surah.number}</span> {surah.transliteration}
    </span>
    <span class="meaning">{surah.name.en}</span>
    <span class="facts">
      {revelationLabel(surah.revelation)}, {plural(surah.ayahCount, "ayah", "ayaat")}
    </span>
  </span>
</a>

<style>
  .surah-card {
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    color: var(--ink);
    text-decoration: none;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    overflow: hidden;
  }

  .surah-card:hover {
    border-color: var(--teal);
  }

  .surah-card:hover .title {
    color: var(--teal);
  }

  img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .body {
    display: grid;
    gap: 0.1rem;
    padding: 0.6rem 0.75rem 0.8rem;
  }

  .title {
    font-weight: 650;
    line-height: 1.3;
  }

  .number {
    color: var(--muted);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    margin-inline-end: 0.15rem;
  }

  .meaning,
  .facts {
    font-size: var(--step--1);
    color: var(--muted);
    line-height: 1.4;
  }
</style>
