{
  "title": "data/names.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "number": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 99
      },
      "transliteration": {
        "type": "string",
        "minLength": 1
      },
      "arabic": {
        "type": "string",
        "minLength": 1
      },
      "urdu": {
        "type": "string",
        "minLength": 1
      },
      "english": {
        "type": "string",
        "minLength": 1
      },
      "root": {
        "type": "string",
        "minLength": 1
      },
      "rootMeaning": {
        "type": "string",
        "minLength": 1
      },
      "category": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "occurrences": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "meaning": {
        "type": "object",
        "properties": {
          "en": {
            "type": "string",
            "minLength": 1
          },
          "ur": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["en", "ur"]
      },
      "inDailyLife": {
        "type": "string",
        "minLength": 1
      },
      "keyAyaat": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^\\d{1,3}:\\d{1,3}$"
        }
      },
      "related": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "themes": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "notes": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "id",
      "number",
      "transliteration",
      "arabic",
      "urdu",
      "english",
      "root",
      "rootMeaning",
      "category",
      "occurrences",
      "meaning",
      "inDailyLife",
      "keyAyaat",
      "related",
      "themes"
    ]
  }
}
