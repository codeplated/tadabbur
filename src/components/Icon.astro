  search: "M10.5 18a7.5 7.5 0 1 1 0-15 7.5 7.5 0 0 1 0 15ZM16 16l4.5 4.5",
  close: "M6 6l12 12M18 6 6 18",
  type: "M4 18 9 6l5 12M5.6 14h6.8M15 18v-5.5a2.5 2.5 0 0 1 5 0V18m0-3h-2.8a2.2 2.2 0 1 0 0 4.4c1.3 0 2.8-.9 2.8-2.4",
  play: "M8 5.5v13l10.5-6.5L8 5.5Z",
  pause: "M8 5v14M16 5v14",
  prev: "M15 5l-7 7 7 7",
  next: "M9 5l7 7-7 7",
  message: "M4 5h16v11H9l-5 4V5Z",
  plus: "M12 5v14M5 12h14",
  minus: "M5 12h14",
  fit: "M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5",
  github:
    "M9 19c-4 1.3-4-2-6-2.5m12 4.5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.3 4.3 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12 12 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.3 4.3 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21",
} as const

interface Props {
  name: keyof typeof paths
  label?: string
}

const { name, label } = Astro.props
const filled = name === "play"
---

<svg
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill={filled ? "currentColor" : "none"}
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : "true"}
  role={label ? "img" : undefined}
  aria-label={label}
>
  <path d={paths[name]}></path>
</svg>
