---
import SurahCard from "../components/SurahCard.astro"
import Base from "../layouts/Base.astro"
import { href } from "../lib/format"
import { site } from "../lib/site"

const s = await site()
const reflect = s.ayah("47:24")
// Surahs many people read regularly, as a first way in.
const often = ["1", "18", "36", "55", "67", "2"].map((id) => s.surah(id))
const groups = s.themeCategories.map((category) => ({ category, themes: s.themesIn(category.id) }))
---

<Base title="Tadabbur">
  <section class="hero">
    <div class="wrap hero-inner">
      <p class="mark" lang="ar" dir="rtl" aria-hidden="true">
        تدبّر
      </p>
      <h1>Tadabbur</h1>
      <p class="lede">
        To reflect deeply; to ponder. Every ayah of all 114 surahs with recitation, Arabic, Urdu and
        English, and Urdu tafsir, cross-linked by theme so one verse leads you to everywhere else
        its ideas appear.
      </p>
      <figure class="quote">
        <blockquote>
          <p class="verse" lang="ar" dir="rtl">
            {reflect.arabic}
          </p>
          <p>{reflect.english}</p>
        </blockquote>
        <figcaption>
          <a href={href.ayah(reflect)}>Quran {reflect.id}</a>
        </figcaption>
      </figure>

      <go-to class="go-to">
        <form action={href.search}>
          <label for="go-to-q">Go to a surah or ayah</label>
          <div class="field">
            <input
              id="go-to-q"
              name="q"
              inputmode="text"
              autocomplete="off"
              placeholder="2:255, or 36"
            />
            <button class="button" type="submit">
              Go
            </button>
          </div>
          <p class="hint small muted" aria-live="polite">
            A surah number, or surah:ayah. Anything else searches.
          </p>
        </form>
      </go-to>
    </div>
    <div class="keffiyeh" aria-hidden="true"></div>
  </section>

  <section class="wrap section" aria-labelledby="start">
    <div class="section-head">
      <h2 id="start">Start reading</h2>
      <a href={href.surahs}>All 114 surahs</a>
    </div>
    <ul class="start plain-list">
      {often.map((surah, i) => (
        <li>
          <SurahCard surah={surah} eager={i < 2} />
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap section" aria-labelledby="topics">
    <div class="section-head">
      <h2 id="topics">Topics of the Quran</h2>
      <a href={href.themes}>All themes</a>
    </div>
    <div class="topic-groups">
      {groups.map(({ category, themes }) => (
        <section aria-labelledby={`c-${category.id}`}>
          <h3 id={`c-${category.id}`}>{category.label}</h3>
          <ul class="chips">
            {themes.map((t) => (
              <li>
                <a class="chip" href={href.theme(t.id)}>
                  {t.label.en}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>

  <section class="wrap section" aria-labelledby="explore">
    <h2 id="explore" class="visually-hidden">
      Explore
    </h2>
    <ul class="explore plain-list">
      <li>
        <a href={href.names}>
          <span class="ar" lang="ar" dir="rtl">
            ٱلْأَسْمَاءُ ٱلْحُسْنَىٰ
          </span>
          <span class="title">Names of Allah</span>
          <span class="muted">The 99 Names: their roots, meanings and where they appear.</span>
        </a>
      </li>
      <li>
        <a href={href.people}>
          <span class="ar" lang="ar" dir="rtl">
            رِجَالٌ وَنِسَاءٌ
          </span>
          <span class="title">People of the Quran</span>
          <span class="muted">
            {s.personalities.length} prophets, companions, nations and others, and their stories.
          </span>
        </a>
      </li>
    </ul>
  </section>
</Base>

<script>
  /** "2:255" or "2 255" goes to the ayah, "36" to the surah; anything else is a search. */
  class GoTo extends HTMLElement {
    connectedCallback() {
      const form = this.querySelector("form")!
      const input = form.querySelector("input")!
      const hint = form.querySelector(".hint")!
      form.addEventListener("submit", (event) => {
        const value = input.value.trim()
        const match = /^(\d{1,3})(?:\s*[:.\s]\s*(\d{1,3}))?$/.exec(value)
        if (!match) return // let the form search
        event.preventDefault()
        const surah = Number(match[1])
        if (surah < 1 || surah > 114) {
          hint.textContent = "Surahs are numbered 1 to 114."
          return
        }
        location.href = match[2] ? `/${surah}/${Number(match[2])}/` : `/${surah}/`
      })
    }
  }
  customElements.define("go-to", GoTo)
</script>

<style>
  .hero {
    position: relative;
    padding-block: clamp(2rem, 8vw, 5rem) 0;
    overflow: hidden;
  }

  .hero-inner {
    display: grid;
    gap: 1.25rem;
    padding-block-end: 2.5rem;
    max-width: 52rem;
  }

  /* The word itself is the hero: large, in the Quran's script, in the logo's ink. */
  .mark {
    font-family: var(--font-arabic);
    font-size: clamp(5rem, 24vw, 10rem);
    line-height: 1.1;
    color: var(--teal);
    margin-block-end: -0.5rem;
  }

  h1 {
    font-size: var(--step-4);
  }

  .lede {
    font-size: var(--step-1);
    line-height: 1.5;
    max-width: 36rem;
  }

  .quote {
    margin: 0.5rem 0 0;
    padding-inline-start: 1.25rem;
    border-inline-start: 3px solid var(--gold);
    max-width: 36rem;
  }

  blockquote {
    margin: 0;
    display: grid;
    gap: 0.25rem;
  }

  .quote .verse {
    font-size: calc(var(--arabic-verse) * 0.85);
  }

  figcaption {
    margin-block-start: 0.5rem;
    font-size: var(--step--1);
  }

  .go-to {
    display: block;
    max-width: 30rem;
    margin-block-start: 0.5rem;
  }

  .go-to label {
    display: block;
    font-weight: 600;
    margin-block-end: 0.4rem;
  }

  .field {
    display: flex;
    gap: 0.5rem;
  }

  .field input {
    flex: 1;
    min-width: 0;
    min-height: var(--tap);
    padding: 0.5rem 1rem;
    font: inherit;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 999px;
  }

  .hint {
    margin-block-start: 0.4rem;
  }

  .keffiyeh {
    height: 3.5rem;
    background: var(--ink);
    opacity: 0.85;
    mask: url("/keffiyeh.svg") left top / 2.1rem 3.5rem repeat-x;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-block-end: 1rem;
  }

  .start {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  @media (min-width: 48rem) {
    .start {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }
  }

  .topic-groups {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 56rem) {
    .topic-groups {
      grid-template-columns: 1fr 1fr;
      gap: 2rem 3rem;
    }
  }

  .topic-groups h3 {
    font-size: var(--step-0);
    margin-block-end: 0.6rem;
  }

  .explore {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 48rem) {
    .explore {
      grid-template-columns: 1fr 1fr;
    }
  }

  .explore a {
    display: grid;
    gap: 0.25rem;
    height: 100%;
    padding: 1.25rem 1.5rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    color: var(--ink);
    text-decoration: none;
  }

  .explore a:hover {
    border-color: var(--teal);
  }

  .explore a:hover .title {
    color: var(--teal);
  }

  .explore .ar {
    font-size: 2rem;
    color: var(--teal-strong);
    line-height: 1.7;
  }

  .explore .title {
    font-size: var(--step-1);
    font-weight: 650;
  }
</style>
