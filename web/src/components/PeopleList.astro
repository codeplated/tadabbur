---
import { href, pathLabel } from "../lib/format"
import type { Personality } from "../lib/site"

interface Props {
  people: Personality[]
  /** Show each person's path; off on a page that is already one path. */
  showPath?: boolean
}

const { people, showPath = true } = Astro.props
---

<ul class="people plain-list">
  {people.map((p) => (
    <li>
      <a href={href.person(p.id)}>
        <span class="name">{p.name.en}</span>
        <span class="ar" lang="ar" dir="rtl">
          {p.name.ar}
        </span>
        <span class="era">{p.era}</span>
        {showPath && <span class:list={["path", p.path]}>{pathLabel[p.path]}</span>}
      </a>
    </li>
  ))}
</ul>

<style>
  .people {
    display: grid;
    gap: 0 2rem;
  }

  @media (min-width: 56rem) {
    .people {
      grid-template-columns: 1fr 1fr;
    }
  }

  .people a {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 0 1rem;
    padding-block: 0.75rem;
    border-block-end: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
  }

  .people a:hover .name {
    color: var(--teal);
    text-decoration: underline;
  }

  .name {
    font-weight: 600;
  }

  .ar {
    font-size: 1.3rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .era,
  .path {
    font-size: var(--step--1);
    color: var(--muted);
  }

  .path {
    grid-column: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .path::before {
    content: "";
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: var(--teal);
  }

  .path.deviated::before {
    background: transparent;
    border: 1.5px solid var(--muted);
  }

  .path.mixed::before {
    background: linear-gradient(90deg, var(--teal) 50%, transparent 50%);
    border: 1.5px solid var(--teal);
  }
</style>
